    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:fix": "eslint . --fix",
    "blur": "node scripts/generate-blur.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.2.12",
    "prettier": "3.4.2",
    "sharp": "0.35.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "0.35.3",
    "nanoid": "^3.3.17"
