# Absolute site URL — required for canonicals, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://hemantsingh.design

# Google Analytics 4 (added in Phase 8). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification token (optional).
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Contact form -----------------------------------------------------------
# Server-side only: these are never exposed to the browser.
#
# Without RESEND_API_KEY the form does not pretend — it says it cannot send
# and offers to open the visitor's mail app instead.
RESEND_API_KEY=

# Where enquiries go. Defaults to the address in lib/site.ts.
CONTACT_TO=

# Who they come from. Defaults to Resend's shared sending address, which
# works with no DNS setup. Swap for an address on a verified domain later.
CONTACT_FROM=
