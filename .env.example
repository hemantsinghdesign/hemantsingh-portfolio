# Absolute site URL — required for canonicals, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://hemantsingh.design

# Google Analytics 4 (added in Phase 8). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification token (optional).
NEXT_PUBLIC_GSC_VERIFICATION=

# The contact form needs no environment variables: it posts to Formspree
# from the browser. See docs/contact-form.md.
